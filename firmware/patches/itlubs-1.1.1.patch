+
+static void web_trigger_handle_command(const char *command, bool *running, uint32_t *remaining)
+{
+    if (strcmp(command, "START") == 0) {
+        web_trigger_start();
+        *remaining = 1000;
+        *running = true;
+    } else if (strcmp(command, "STOP") == 0) {
+        *running = false;
+        *remaining = 0;
+        xlat_auto_trigger_turn_off_action();
+    } else if (strcmp(command, "CLEAR") == 0) {
+        xlat_reset_latency();
+    } else if (strcmp(command, "REBOOT") == 0) {
+        NVIC_SystemReset();
+    } else if (strcmp(command, "EDGE RISING") == 0) {
+        hw_config_input_trigger(HW_INPUT_TRIGGER_RISING);
+    } else if (strcmp(command, "EDGE FALLING") == 0) {
+        hw_config_input_trigger(HW_INPUT_TRIGGER_FALLING);
+    } else if (strcmp(command, "EDGE BOTH") == 0) {
+        hw_config_input_trigger(HW_INPUT_TRIGGER_BOTH);
+    } else if (strncmp(command, "DEBOUNCE ", 9) == 0) {
+        uint32_t milliseconds = (uint32_t)strtoul(command + 9, NULL, 10);
+        if (milliseconds == 20 || milliseconds == 50 || milliseconds == 100 || milliseconds == 200 || milliseconds == 500 || milliseconds == 1000) {
+            xlat_set_gpio_irq_holdoff_us(milliseconds * 1000);
+        }
+    } else if (strcmp(command, "TRIGGER_LEVEL HIGH") == 0) {
+        xlat_auto_trigger_level_set(true);
+    } else if (strcmp(command, "TRIGGER_LEVEL LOW") == 0) {
+        xlat_auto_trigger_level_set(false);
+    } else if (strcmp(command, "MODE CLICK") == 0) {
+        xlat_set_mode(XLAT_MODE_CLICK);
+    } else if (strcmp(command, "MODE MOTION") == 0) {
+        xlat_set_mode(XLAT_MODE_MOTION);
+    } else if (strcmp(command, "STATUS") == 0) {
+        web_trigger_status(*running);
+    }
+}
+
+static void web_trigger_run(void)
+{
+    uint32_t remaining = 1000;
+    bool running = false;
+    bool trigger_active = false;
+    uint32_t next_action_at = 0;
+    char command[32];
+    size_t command_length = 0;
+
+    while (1) {
+        uint8_t byte;
+
+        if (HAL_UART_Receive(&huart1, &byte, 1, 1) == HAL_OK) {
+            if (byte == '\r' || byte == '\n') {
+                command[command_length] = '\0';
+                if (command_length > 0) {
+                    web_trigger_handle_command(command, &running, &remaining);
+                }
+                command_length = 0;
+            } else if (command_length < sizeof(command) - 1) {
+                command[command_length++] = (char)byte;
+            } else {
+                command_length = 0;
+            }
+        }
+
+        if (!running || !xlat_initialized) {
+            trigger_active = false;
+            osDelay(1);
+            continue;
+        }
+
+        uint32_t now = xTaskGetTickCount();
+        if ((int32_t)(now - next_action_at) < 0) {
+            osDelay(1);
+            continue;
+        }
+
+        if (!trigger_active) {
+            xlat_auto_trigger_action();
+            trigger_active = true;
+            next_action_at = now + AUTO_TRIGGER_PRESSED_PERIOD_MS;
+        } else {
+            xlat_auto_trigger_turn_off_action();
+            trigger_active = false;
+            remaining--;
+            if (!remaining) {
+                running = false;
+            } else {
+                next_action_at = now + AUTO_TRIGGER_PERIOD_MS - AUTO_TRIGGER_PRESSED_PERIOD_MS + (rand() % 10);
+            }
+        }
+    }
+}
+
+static void vcp_command_task(void const * argument)
+{
+    (void)argument;
+    web_trigger_run();
+}
